NODE_ENV=production
PORT=4000

DATABASE_URL=postgres://automl:change-me@127.0.0.1:5432/automl
PGSSLMODE=disable

JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=

FRONTEND_URL=https://your-project.vercel.app
ALLOWED_ORIGINS=https://your-project.vercel.app

DOCKER_ENABLED=true
# DELIBERATE, AND IT WEAKENS THE SANDBOX. Everywhere else this defaults to
# `automl-sandbox`, a network created with `--internal` that blocks outbound
# internet and SSRF. `bridge` gives execution containers full egress. It is set
# here because the install_package tool runs `pip install` inside the container
# and cannot reach PyPI on an internal network.
#
# What still holds on bridge: non-root user, read-only root filesystem, capped
# CPU and memory, and `--add-host host.docker.internal:0.0.0.0` to block SSRF
# back to the host even when the network is overridden.
# What does not: outbound internet from executed code is reachable. Untrusted
# code should not be run against this configuration.
EXECUTION_NETWORK=bridge

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=replace-with-app-password
SMTP_FROM=Agentic AutoML Platform <your-sender@gmail.com>

GOOGLE_AUTH_ENABLED=false
