<section class="footer-cta" aria-labelledby="footer-cta-heading">
  <p class="footer-cta-eyebrow">READY WHEN YOU ARE</p>
  <h2 class="footer-cta-headline" id="footer-cta-heading">
    Stop babysitting
    <span class="footer-cta-headline-muted">your notebooks.</span>
  </h2>
  <p class="footer-cta-body">
    The agent reads your data, writes the code, trains the models,
    and hands you a reproducible result.
  </p>
  <span class="footer-cta-button footer-cta-soon" aria-disabled="true">Coming soon</span>
  <p class="footer-cta-note">
    The platform is in active development and open to collaborators and sponsors.
    <a class="footer-cta-contact" href="mailto:aesh.03.23@gmail.com">Reach out to contribute or sponsor →</a>
  </p>
</section>

<style>
  .footer-cta {
    max-width: 880px;
    margin: 0 auto;
    padding: 64px 32px;
    text-align: center;
  }

  .footer-cta-eyebrow {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 13px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 32px;
  }

  .footer-cta-headline {
    font-family: 'Inter Variable', sans-serif;
    font-size: clamp(48px, 7vw, 72px);
    font-weight: 510;
    letter-spacing: -0.022em;
    line-height: 1;
    margin: 0 0 40px;
  }
  .footer-cta-headline-muted {
    display: block;
    color: var(--text-muted);
  }

  .footer-cta-body {
    font-family: 'Geist Mono Variable', monospace;
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.55;
    max-width: 620px;
    margin: 0 auto 48px;
  }

  .footer-cta-button {
    font-family: 'Inter Variable', sans-serif;
    font-size: 18px;
    font-weight: 510;
    color: var(--cta-text);
    text-decoration: none;
    background: var(--cta-bg-grad);
    padding: 0 48px;
    height: 52px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 6px;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.2),
      0 2px 4px rgba(0, 0, 0, 0.04),
      0 12px 32px rgba(0, 0, 0, 0.10);
    transition: transform var(--dur-fast) var(--ease-linear-default),
                gap var(--dur-fast) var(--ease-linear-default);
  }
  .footer-cta-button:hover {
    transform: translateY(-1px);
    gap: 14px;
  }
  .footer-cta-arrow {
    flex-shrink: 0;
    transition: transform var(--dur-fast) var(--ease-linear-default);
  }
  .footer-cta-button:hover .footer-cta-arrow {
    transform: translateX(2px);
  }

  /* Auth is not yet available on this standalone marketing site, so the
     primary CTA renders as a non-interactive "Coming soon" state. */
  .footer-cta-soon {
    cursor: default;
    opacity: 0.62;
    pointer-events: none;
  }

  /* While auth is "Coming soon", give visitors a real path to get involved. */
  .footer-cta-note {
    margin: 24px auto 0;
    max-width: 560px;
    font-family: 'Geist Mono Variable', monospace;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-dim);
  }
  .footer-cta-contact {
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) var(--ease-linear-default),
                border-color var(--dur-fast) var(--ease-linear-default);
  }
  .footer-cta-contact:hover {
    color: var(--text);
    border-bottom-color: hsl(var(--border-accent, var(--border)));
  }
</style>
