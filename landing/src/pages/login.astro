---
// Standalone marketing site: accounts are not hosted yet, so the /login route
// no longer redirects into the app. It renders a self-contained "Coming soon"
// placeholder (reverting to the original pre-demo intent).
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/automl-logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="robots" content="noindex" />
    <title>Coming soon — Agentic AutoML Platform</title>
  </head>
  <body
    style="margin:0;min-height:100vh;display:grid;place-items:center;background:#0A0A0B;color:#F7F8F8;font-family:Inter,system-ui,sans-serif;"
  >
    <main style="text-align:center;max-width:32rem;padding:2rem;">
      <p style="margin:0 0 0.5rem;font-size:0.75rem;letter-spacing:0.08em;text-transform:uppercase;color:#8A8F98;">
        Sign in
      </p>
      <h1 style="margin:0 0 1rem;font-size:1.6rem;font-weight:510;line-height:1.3;">Coming soon</h1>
      <p style="margin:0 0 1.75rem;font-size:1rem;line-height:1.5;color:#B4B8BF;">
        Accounts aren't available just yet. Check back soon.
      </p>
      <a href="/" style="color:#F7F8F8;">Back to home</a>
    </main>
  </body>
</html>
